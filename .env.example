PRIVATE_KEY=
FUNDER_ADDRESS=

# CLOB API keys
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# Precautionary measure: set to true to delete all open orders in immediate markets
DELETE_ALL_ORDERS=false
DELETE_ALL_SIZES=

# Cancel all orders on ongoing markets N seconds before they end.
# Set to 0 or leave empty to disable. Default: 30
CANCEL_BEFORE_END_SECONDS=30

# Comma-separated slug substrings: matching markets will have ALL orders deleted
# (e.g. "doge-updown-15m" deletes all orders for doge 15m markets)
DELETE_ALL_SLUGS=doge-updown-15m

# Comma-separated prices: ALL orders at these prices will be canceled instead of kept
# (e.g. "0.01,0.03" deletes all orders priced at 1 cent and 3 cents)
DELETE_ALL_PRICES=

# Comma-separated list of asset tickers to generate market slugs for
ASSETS=eth,btc,sol,xrp,doge,bnb,hype

# Automatically cancel opposite buy orders when one side fills (even partially)
# Run: npm run watch   (runs src/fill-watcher.js via WebSocket)
CANCEL_OPPOSITE_ON_FILL=

# Cancel all orders on a market if live Polymarket Chainlink TWAP deviates from market open price
# by more than the specified percentage threshold (e.g. 0.3 for 0.3%, 0.5 for 0.5%).
# Configured separately per asset:
CANCEL_THRES_BTC=
CANCEL_THRES_ETH=
CANCEL_THRES_SOL=
CANCEL_THRES_XRP=
CANCEL_THRES_DOGE=
CANCEL_THRES_BNB=
CANCEL_THRES_HYPE=
# Optional fallback threshold for any asset not explicitly defined above:
CANCEL_THRES_DEFAULT=
