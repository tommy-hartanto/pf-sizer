# ─── Predict.fun Wallet & API Credentials ─────────────────────
# Private key of the signing wallet (EOA or privy signer)
PREDICT_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
# Predict account address (smart wallet) or your EOA address
PREDICT_ACCOUNT_ADDRESS=0xYOUR_ACCOUNT_ADDRESS_HERE
# Predict.fun API Key (Required for BNB Mainnet; get from predict.fun settings)
PREDICT_API_KEY=pred_sk_your_api_key_here

# ─── Chain & Exchange Configuration ───────────────────────────
# BNB Mainnet: 56, BNB Testnet: 97
PREDICT_CHAIN_ID=56
# CTF Exchange Contract (BNB Mainnet default: 0x8BC070BEdAB741406F4B1Eb65A72bee27894B689)
PREDICT_EXCHANGE_ADDRESS=0x8BC070BEdAB741406F4B1Eb65A72bee27894B689
# Default Fee Rate in BPS (default: 200 = 2%)
FEE_RATE_BPS=200
# BNB Chain JSON-RPC URL for balance queries
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# ─── Bot Controls & Sizing ────────────────────────────────────
# Precautionary measure: set to true to delete all open orders in immediate markets
DELETE_ALL_ORDERS=false
DELETE_ALL_SIZES=

# Cancel all orders on ongoing markets N seconds before they end.
# Set to 0 or leave empty to disable. Default: 30
CANCEL_BEFORE_END_SECONDS=30

# Comma-separated slug substrings: matching markets will have ALL orders deleted
# (e.g. "doge-updown-15m" deletes all orders for doge 15m markets)
DELETE_ALL_SLUGS=

# Comma-separated prices: ALL orders at these prices will be canceled instead of kept
# (e.g. "0.01,0.03" deletes all orders priced at 1 cent and 3 cents)
DELETE_ALL_PRICES=

# Target markets to follow (defaults strictly to the currently active timestamp market).
# Format examples:
#   ASSETS=btc-updown-5m
#   ASSETS=btc-updown-5m,btc-updown-15m
#   ASSETS=btc-updown-5m,eth-updown-5m,sol-updown-15m
#   ASSETS=btc,eth  (defaults to 5m)
ASSETS=btc-updown-5m


# Automatically cancel opposite buy orders when one side fills (even partially)
# Run: npm run watch   (runs src/fill-watcher.js via WebSocket)
CANCEL_OPPOSITE_ON_FILL=false

# Cancel all orders on a market if live TWAP / mark price deviates from market open price
# by more than the specified percentage threshold (e.g. 0.3 for 0.3%, 0.5 for 0.5%).
# Configured separately per asset:
CANCEL_THRES_BTC=
CANCEL_THRES_ETH=
CANCEL_THRES_SOL=
CANCEL_THRES_XRP=
CANCEL_THRES_DOGE=
CANCEL_THRES_BNB=
CANCEL_THRES_HYPE=
# Optional fallback threshold for any asset not explicitly defined above:
CANCEL_THRES_DEFAULT=
